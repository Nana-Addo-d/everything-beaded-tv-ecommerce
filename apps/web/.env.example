# Server-only values. Set these in apps/web/.env.local or the hosting secret store.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Public Auth key; this value is intentionally supplied to merchant sign-in in the browser.
SUPABASE_PUBLISHABLE_KEY=
STORE_ORIGIN=
# Enable search indexing only after public release checks pass.
STORE_INDEXABLE=false
# Use test until the real-provider acceptance checks have passed.
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
# Random value of at least 32 characters; scheduler sends Authorization: Bearer <value>.
COMMERCE_JOB_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
STORE_EMAIL_FROM=
